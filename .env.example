# Copy to `.env` and adjust. `.env` is git-ignored - never commit real values.
#
# `docker compose up` works without this file (development defaults are built into
# docker-compose.yml). In production, inject these as environment variables from a
# secret store (see docs/deployment-aws.md) instead of using a file.

# ------------------------------------------------------------------ application
# development | test | production
ENVIRONMENT=development
LOG_LEVEL=INFO
# Serve /docs, /redoc and /openapi.json
DOCS_ENABLED=true
PORT=8000
# Comma-separated proxy addresses whose X-Forwarded-* headers are trusted.
FORWARDED_ALLOW_IPS=127.0.0.1

# Signs access tokens. At least 32 characters; generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# --------------------------------------------------------------------- database
# Runtime role: restricted, subject to row-level security. Used by API and worker.
DATABASE_URL=postgresql+asyncpg://teamboard_app:app-password@localhost:5432/teamboard
# Owner role: used ONLY by Alembic (`alembic upgrade head`), never by the app.
MIGRATION_DATABASE_URL=postgresql+asyncpg://teamboard_owner:owner-password@localhost:5432/teamboard
# Name of the runtime role that migrations grant privileges to.
APP_DB_ROLE=teamboard_app
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_STATEMENT_TIMEOUT_MS=30000

# ------------------------------------------------------------------------ redis
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------------- docker compose (local only)
OWNER_DB_PASSWORD=teamboard_owner_dev
APP_DB_PASSWORD=teamboard_app_dev
API_PORT=8000
